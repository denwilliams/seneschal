# Account-level secrets. Under Docker this whole file is passed to the harness
# container, so a provider key added here needs no change to docker-compose.yml.
# Per-channel secrets do not belong here — see data/channels/<id>/env.
#
# Slack credentials (Socket Mode — no public URL or inbound ports needed).
#
# SLACK_BOT_TOKEN comes from OAuth & Permissions ("Bot User OAuth Token", xoxb-…)
# SLACK_APP_TOKEN comes from Basic Information → App-Level Tokens, with the
#   connections:write scope (xapp-…)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Model providers. Set at least one — the harness lists and offers only models
# whose provider has credentials. The default model is deepseek-v4-pro.
#
# These are pay-per-token API keys. To use a subscription instead (ChatGPT via
# openai-codex, Claude Pro/Max, GitHub Copilot), you do not set a key here —
# run `npm run login` and pick the provider. See the Models section of the
# README.
DEEPSEEK_API_KEY=your-deepseek-key
OPENAI_API_KEY=sk-your-openai-key

# Optional, if you also want Anthropic models available:
# ANTHROPIC_API_KEY=sk-ant-your-key

# Optional: point at a different config file.
# HARNESS_CONFIG=./config/harness.yaml

# Optional: debug | info | warn | error
LOG_LEVEL=info

# Optional: bounded memory/process samples and connector lifecycle events in info logs.
# Seconds between samples (1–3600); unset to disable. No retained in-memory history.
# See docs/memory-investigation.md for scopes, capture steps and limitations.
# HARNESS_MEMORY_SAMPLE_SECONDS=60
