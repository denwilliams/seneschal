{
  "name": "console2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mock": "node mock/server.mjs",
    "e2e": "playwright test",
    "e2e:real": "playwright test -c playwright.real.config.ts",
    "shots:factory-runs": "SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts",
    "shots:factory-intake": "SCREENSHOTS=1 playwright test e2e/screenshots-intake.spec.ts",
    "shots:factory-labels": "SCREENSHOTS=1 playwright test e2e/screenshots-labels.spec.ts",
    "shots:factory-shared-login": "SCREENSHOTS=1 playwright test e2e/screenshots-shared-login.spec.ts",
    "shots:sidebar-collapse": "SCREENSHOTS=1 playwright test e2e/screenshots-sidebar.spec.ts && python3 scripts/shrink-pngs.py ../../docs/screenshots/sidebar-collapse",
    "shots:console-actions": "SCREENSHOTS=1 playwright test e2e/screenshots-actions.spec.ts && python3 scripts/shrink-pngs.py ../../docs/screenshots/console-actions",
    "shots:factory-retry": "SCREENSHOTS=1 playwright test e2e/screenshots-retry.spec.ts && python3 scripts/shrink-pngs.py ../../docs/screenshots/factory-retry",
    "shots:yaml-editor": "SCREENSHOTS=1 playwright test e2e/screenshots-yaml-editor.spec.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.7",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
